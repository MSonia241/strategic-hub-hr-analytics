          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'import matplotlib.pyplot as plt\nimport seaborn as sns\nimport pandas as pd\n\n# 1. Setăm dimensiunea figurii\nplt.figure(figsize=(10, 8))\n\n# 2. Selectăm explicit coloanele (ca să nu ia și ID_Angajat sau alte cifre inutile)\n# Asigură-te că aceste nume sunt exact ca în dataset-ul tău\ncols_to_use = [''Ore_Lucrate'', ''Proiecte_Finalizate'', ''Feedback_Clienti'', ''Scor_Performanta'', ''Risc_Plecare_Scor'']\n\n# Facem o copie a datelor doar cu aceste coloane\ndf_plot = dataset[cols_to_use].copy()\n\n# 3. REDENUMIM coloanele pentru afișare (Aici e \"Makeover\"-ul)\n# Stânga = Cum e în baza de date | Dreapta = Cum vrei să apară pe ecran\ndf_plot = df_plot.rename(columns={\n    ''Ore_Lucrate'': ''Ore Lucrate (Efort)'',\n    ''Proiecte_Finalizate'': ''Proiecte Finalizate'',\n    ''Feedback_Clienti'': ''Feedback Clienți'',\n    ''Scor_Performanta'': ''Scor Performanță'',\n    ''Risc_Plecare_Scor'': ''Risc Plecare''\n})\n\n# 4. Calculăm corelația pe datele redenumite\ncorr_matrix = df_plot.corr()\n\n# 5. Desenăm Heatmap-ul\n# vmin=-1, vmax=1 asigură că 0 e alb, 1 e roșu intens, -1 e albastru intens\nsns.heatmap(corr_matrix, \n            annot=True, \n            cmap=''coolwarm'', \n            fmt=\".2f\", \n            linewidths=1, \n            linecolor=''white'',\n            vmin=-1, vmax=1)\n\n# 6. STILIZARE FINALĂ (Rotim textul)\nplt.title(''Matricea de Corelație (Factori de Influență)'', fontsize=16, pad=20)\n\n# Rotim etichetele de jos la 45 de grade ca să nu se încalece\nplt.xticks(rotation=45, ha=''right'', fontsize=11)\n\n# Lăsăm etichetele din stânga orizontale\nplt.yticks(rotation=0, fontsize=11)\n\n# 7. Comanda magică: previne tăierea textului la margini\nplt.tight_layout()\n\nplt.show()'"
                }
              }
            },
