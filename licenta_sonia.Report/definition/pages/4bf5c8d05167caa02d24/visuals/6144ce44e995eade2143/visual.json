    "objects": {
      "script": [
        {
          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'import matplotlib.pyplot as plt\n\nplt.close(''all'')\n\nif not dataset.empty:\n    try:\n        col_perf = next((c for c in dataset.columns if ''Performanta'' in c), None)\n        if col_perf is None:\n            raise ValueError(f\"Coloana lipsa! Disponibile: {list(dataset.columns)}\")\n\n        status   = dataset[''Status_Risc''].iloc[0]\n        scor     = dataset[col_perf].iloc[0]\n        senior   = dataset[''Senioritate''].iloc[0]\n        nume_id  = dataset[''ID_Angajat''].iloc[0]\n        ore      = dataset[''Ore_Lucrate''].iloc[0]\n        feedback = dataset[''Feedback_Clienti''].iloc[0]\n        proiecte = dataset[''Proiecte_Finalizate''].iloc[0]\n        training = dataset[''Training_Ore''].iloc[0]\n\n        actiuni = []\n\n        if status == ''Risc Ridicat'':\n            titlu   = f\"⚠ ALERTA (ID {nume_id}): Risc de plecare detectat!\"\n            culoare = ''#e74c3c''\n            if ore > 220:\n                actiuni.append(\"• Reducere imediata a orelor suplimentare\")\n            if feedback < 3:\n                actiuni.append(\"• Sesiune urgenta 1-la-1 cu clientii\")\n            if proiecte < 5:\n                actiuni.append(\"• Revizuire prioritati si deblocare taskuri\")\n            if training < 10:\n                actiuni.append(\"• Inscrie in program de suport si training\")\n            if not actiuni:\n                actiuni.append(\"• Monitorizare intensiva si discutie cu managerul\")\n\n        elif status == ''Potential'':\n            titlu   = f\"★ POTENTIAL (ID {nume_id}): Performanta ridicata!\"\n            culoare = ''#27ae60''\n            if scor > 350:\n                actiuni.append(\"• Candidat pentru promovare — evalueaza imediat\")\n            if senior == ''Senior'':\n                actiuni.append(\"• Atribuie rol de lead pe proiect nou\")\n            if training < 10:\n                actiuni.append(\"• Inscrie in program de mentorat avansat\")\n            if feedback > 4.5:\n                actiuni.append(\"• Nominalizeaza pentru premiul lunii\")\n            if proiecte > 12:\n                actiuni.append(\"• Evalueaza transfer catre echipa mai solicitanta\")\n            if not actiuni:\n                actiuni.append(\"• Continua dezvoltarea si ofera proiecte complexe\")\n\n        else:\n            titlu   = f\"✓ STABIL (ID {nume_id}): Parcurs normal\"\n            culoare = ''#2980b9''\n            if feedback > 4.5:\n                actiuni.append(\"• Nominalizeaza pentru premiul lunii\")\n            if proiecte > 12:\n                actiuni.append(\"• Evalueaza pentru proiecte mai complexe\")\n            if ore > 200:\n                actiuni.append(\"• Atentie: ore in crestere — monitorizeaza lunar\")\n            if not actiuni:\n                actiuni.append(\"• Monitorizare lunara standard — totul in parametri\")\n\n        text = titlu + \"\\n\\n\" + \"\\n\".join(actiuni)\n\n        fig, ax = plt.subplots(figsize=(14, 6))\n        ax.axis(''off'')\n        ax.text(0.5, 0.5, text, ha=''center'', va=''center'', fontsize=20,\n                fontweight=''bold'', color=''white'', transform=ax.transAxes,\n                linespacing=2.2,\n                bbox=dict(facecolor=culoare, alpha=0.9, edgecolor=''none'', boxstyle=''round,pad=2''))\n        plt.tight_layout()\n        plt.show()\n\n    except Exception as e:\n        fig, ax = plt.subplots(figsize=(10, 4))\n        ax.text(0.5, 0.5, f\"Eroare: {str(e)}\", ha=''center'', color=''red'', transform=ax.transAxes, fontsize=13)\n        ax.axis(''off'')\n        plt.show()\n\nelse:\n    fig, ax = plt.subplots(figsize=(10, 4))\n    ax.text(0.5, 0.5, \"Selectati un angajat din Slicer\", ha=''center'', color=''gray'', transform=ax.transAxes, fontsize=13)\n    ax.axis(''off'')\n    plt.show()'"
                }
              }
