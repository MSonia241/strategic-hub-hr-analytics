    "objects": {
      "script": [
        {
          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'import matplotlib\nmatplotlib.use(''Agg'')\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n# ── 1. SLIDER ─────────────────────────────────────────────────────────────\nvaloare_slicer = float(dataset[''Simulare_Training Value''].max())\nvaloare_slicer = max(0, min(50, valoare_slicer))\n\n# ── 2. LUĂM DOAR ULTIMA LUNĂ PER ANGAJAT (200 unici, nu 2400) ────────────\ndataset = dataset.sort_values([''Year'', ''Month'', ''Day'']).groupby(''ID_Angajat'').last().reset_index()\n\n# ── 3. EXTRAGEM VALORILE ──────────────────────────────────────────────────\nore      = dataset[''Ore_Lucrate''].values.astype(float)\nfeedback = dataset[''Feedback_Clienti''].values.astype(float)\ntraining = dataset[''Training_Ore''].values.astype(float)\n\nif feedback.max() > 5:\n    feedback = feedback / 10\n\n# ── 4. CALCULĂM RISCUL CU DISTRIBUȚIE GRADUALĂ ───────────────────────────\nore_factor      = np.clip((ore - 200) / 60, 0, 1)\nfeedback_factor = np.clip((3 - feedback) / 2, 0, 1)\nscor_risc       = (ore_factor * 0.5) + (feedback_factor * 0.5)\n\nrisc             = np.zeros(len(ore))\nmask_risc        = (ore > 200) & (feedback < 3)\nrisc[mask_risc]  = 0.55 + (scor_risc[mask_risc] * 0.45)\nrisc[training > 20] -= 0.1\n\nTOTAL        = len(risc)\nRISC_INITIAL = int(np.sum(risc > 0.5))\n\n# ── 5. APLICĂM SLIDERUL ───────────────────────────────────────────────────\nreducere     = (valoare_slicer / 50.0) * 0.6\nrisc_simulat = risc - reducere\n\nn_risc   = int(np.sum(risc_simulat > 0.5))\nn_stabil = TOTAL - n_risc\nsalvati  = RISC_INITIAL - n_risc\n\n# ── 6. GRAFIC ─────────────────────────────────────────────────────────────\nfig, ax = plt.subplots(figsize=(9, 6))\nfig.patch.set_facecolor(''#1a1a2e'')\nax.set_facecolor(''#16213e'')\n\nbare = ax.bar(\n    [''Risc Ridicat'', ''Stabil''],\n    [n_risc, n_stabil],\n    color=[''#e74c3c'', ''#2ecc71''],\n    edgecolor=''white'', linewidth=1.5, width=0.5\n)\n\nfor bar, val, col in zip(bare, [n_risc, n_stabil], [''#e74c3c'', ''#2ecc71'']):\n    ax.text(\n        bar.get_x() + bar.get_width() / 2,\n        bar.get_height() + 2,\n        str(val),\n        ha=''center'', fontweight=''bold'', fontsize=22, color=col\n    )\n\nax.set_ylim(0, TOTAL + 30)\nax.set_title(\n    f''Impact: +{int(valoare_slicer)} ore training  |  Populatie: {TOTAL} angajati'',\n    fontsize=13, fontweight=''bold'', color=''white'', pad=15\n)\nax.tick_params(colors=''white'', labelsize=12)\nfor sp in [''top'', ''right'']: ax.spines[sp].set_visible(False)\nfor sp in [''bottom'', ''left'']: ax.spines[sp].set_color(''#444'')\n\nax.axhline(y=RISC_INITIAL, color=''#e74c3c'', linestyle=''--'', alpha=0.35, linewidth=1)\nax.text(1.53, RISC_INITIAL + 1, f''Initial: {RISC_INITIAL}'',\n        color=''#e74c3c'', alpha=0.6, fontsize=9)\n\nif salvati > 0:\n    mesaj       = f''  {salvati} angajati salvati fata de situatia initiala  ''\n    culoare_box = ''#f1c40f''\n    culoare_txt = ''#1a1a2e''\nelse:\n    mesaj       = ''  Misca slider-ul pentru a vedea impactul  ''\n    culoare_box = ''#2c3e50''\n    culoare_txt = ''#95a5a6''\n\nax.text(\n    0.5, 0.12, mesaj,\n    transform=ax.transAxes,\n    ha=''center'', va=''center'',\n    fontsize=13, fontweight=''bold'', color=culoare_txt,\n    bbox=dict(facecolor=culoare_box, edgecolor=''white'',\n              boxstyle=''round,pad=0.6'', alpha=0.95)\n)\n\nax.text(\n    0.5, -0.11,\n    f''Slider: {int(valoare_slicer)} ore  |  Prag risc: >0.5  |  Initial in risc: {RISC_INITIAL}'',\n    ha=''center'', transform=ax.transAxes,\n    fontsize=9, color=''#7f8c8d'', style=''italic''\n)\n\nplt.tight_layout()\nplt.show()'"
                }
              }
            },
