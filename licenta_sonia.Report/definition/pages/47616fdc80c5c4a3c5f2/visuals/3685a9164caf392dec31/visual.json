    "objects": {
      "script": [
        {
          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'import matplotlib.pyplot as plt\nimport seaborn as sns\nimport pandas as pd\nfrom sklearn.cluster import KMeans\n\nX = dataset[[''Ore_Lucrate'', ''Scor_Performanta'']]\n\nkmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\ndataset[''Grup_AI''] = kmeans.fit_predict(X)\n\n# Denumim clusterii în funcție de scorul mediu\ncluster_means = dataset.groupby(''Grup_AI'')[''Scor_Performanta''].mean().sort_values()\nlabel_map = {\n    cluster_means.index[0]: ''Low Performers'',\n    cluster_means.index[1]: ''Core Performers'', \n    cluster_means.index[2]: ''Top Talents''\n}\ndataset[''Grup_Nume''] = dataset[''Grup_AI''].map(label_map)\n\nplt.figure(figsize=(12, 7))\n\nculori = {''Low Performers'': ''#8B008B'', ''Core Performers'': ''#DAA520'', ''Top Talents'': ''#2E8B57''}\n\nsns.scatterplot(\n    data=dataset,\n    x=''Ore_Lucrate'',\n    y=''Scor_Performanta'',\n    hue=''Grup_Nume'',\n    palette=culori,\n    s=150,\n    alpha=0.6,\n    edgecolor=''black''\n)\n\ncenters = kmeans.cluster_centers_\nplt.scatter(\n    centers[:, 0], \n    centers[:, 1], \n    c=''red'', \n    s=400, \n    marker=''X'', \n    label=''Centroid (Media Grupului)'',\n    edgecolor=''white'',\n    linewidth=3\n)\n\nplt.axvline(x=220, color=''red'', linestyle=''--'', linewidth=1.5, label=''Prag Burnout (220h)'')\n\nplt.title(''Segmentarea Automată a Angajaților (K-Means)'', fontsize=16, fontweight=''bold'')\nplt.xlabel(''Ore Lucrate (Efort)'', fontsize=12)\nplt.ylabel(''Scor Performanță (Rezultate)'', fontsize=12)\nplt.legend(loc=''upper left'')\nplt.grid(True, alpha=0.3)\n\nplt.show()'"
                }
              }
