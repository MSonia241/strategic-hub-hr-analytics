    "objects": {
      "script": [
        {
          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'import matplotlib.pyplot as plt\nimport numpy as np\n\n# Safety check: only run if we have data\nif not dataset.empty:\n    # 1. Prepare labels\n    labels = [''Effort (Hours)'', ''Results'', ''Feedback'', ''Performance'']\n    \n    # 2. Get the first employee''s data (make sure columns exist in Values bucket!)\n    # We use .get() to avoid crashing if a column is missing\n    valori = [\n        dataset[''Ore_Lucrate''].iloc[0] / 220, \n        dataset[''Proiecte_Finalizate''].iloc[0] / 15,\n        dataset[''Feedback_Clienti''].iloc[0] / 5,\n        dataset[''Scor_Performanta''].iloc[0] / 400\n    ]\n\n    # 3. Create the circular angles\n    angles = np.linspace(0, 2 * np.pi, len(labels), endpoint=False).tolist()\n    \n    # 4. Close the circular loop\n    valori += valori[:1]\n    angles += angles[:1]\n\n    # 5. Plotting\n    fig, ax = plt.subplots(figsize=(6, 6), subplot_kw=dict(polar=True))\n    ax.fill(angles, valori, color=''teal'', alpha=0.3)\n    ax.plot(angles, valori, color=''teal'', linewidth=2)\n    \n    # Design tweaks\n    ax.set_yticklabels([])\n    ax.set_xticks(angles[:-1])\n    ax.set_xticklabels(labels, fontsize=10, fontweight=''bold'')\n    \n    # Title showing the specific Employee ID\n    emp_id = dataset[''ID_Angajat''].iloc[0]\n    plt.title(f\"Competency Profile - Employee ID: {emp_id}\", pad=20)\n    \n    plt.tight_layout()\n    plt.show()\nelse:\n    # If no data is selected, show a blank plot with a message\n    plt.text(0.5, 0.5, \"Please select an employee\")\n    plt.show()'"
                }
              }
            },
            "provider": {
