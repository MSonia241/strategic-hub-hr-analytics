          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'import matplotlib.pyplot as plt\nimport seaborn as sns\n\nsns.set(style=\"whitegrid\")\nplt.figure(figsize=(10, 8))\n\nscatter = sns.scatterplot(x=''Ore_Lucrate'', \n                          y=''Scor_Performanta'', \n                          hue=''Status_Risc'', \n                          size=''Proiecte_Finalizate'', \n                          sizes=(100, 1000),\n                          palette={\"Stabil\": \"#3498db\", \"Risc Ridicat\": \"#e74c3c\", \"Potential\": \"#27ae60\"},\n                          alpha=0.6,\n                          data=dataset)\n\nplt.xlim(dataset[''Ore_Lucrate''].min() - 10, dataset[''Ore_Lucrate''].max() + 10)\nplt.ylim(dataset[''Scor_Performanta''].min() - 20, dataset[''Scor_Performanta''].max() + 20)\n\nplt.title(''Matricea Burnout: Efort (Ore) vs. Rezultat (Scor)'', fontsize=16, fontweight=''bold'', pad=20)\nplt.xlabel(''Ore Lucrate (Medie Lunară)'', fontsize=12)\nplt.ylabel(''Scor Performanță'', fontsize=12)\n\nplt.legend(bbox_to_anchor=(1.05, 1), loc=''upper left'', title=''Status Risc'')\n\nplt.tight_layout()\nplt.show()'"
                }
              }
